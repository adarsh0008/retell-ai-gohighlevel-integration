# Server
PORT=3000

# Retell AI API key (used to verify webhook signatures)
RETELL_API_KEY=your_retell_api_key

# GoHighLevel Private Integration token (Settings > Private Integrations)
# Required scopes: contacts.write, contacts.readonly
GHL_PRIVATE_TOKEN=your_ghl_private_integration_token
GHL_LOCATION_ID=your_ghl_location_id

# Comma-separated tags added to every synced contact
GHL_DEFAULT_TAGS=ai-call,retell-ai
